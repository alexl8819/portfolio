---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer';
import Header from '../components/Header';
import Portfolio from '../components/Portfolio';

const author = import.meta.env.AUTHOR;
const name = import.meta.env.NAME;
const description = import.meta.env.DESCRIPTION;
const links = import.meta.env.LINKS;
const repos = import.meta.env.REPOS;
const skills = import.meta.env.SKILLS;
const certs = import.meta.env.EARNED_CERTS;
const aboutMe = import.meta.env.ABOUT_ME;

const sitekey = import.meta.env.SITEKEY;

if (!sitekey) {
	throw new Error('sitekey must be defined for captcha');
}

const endpoint = import.meta.env.ENDPOINT;

if (!endpoint) {
	throw new Error('endpoint must be defined to send contact messages');
}
---

<Layout>
	<div class="min-h-screen bg-white text-zinc-800">
		<Header client:load />
		<Portfolio
			author={author || ''}
			name={name || 'John Doe'} 
			description={description || ''}
			links={links || '{"github": "", "codepen": ""}'}
			repos={repos || '[]'}
			skills={skills || '{"languages":[],"frameworks":[],"databases":[],"tools":[],"platforms":[]}'}
			certs={certs || '[]'}
			aboutMe={aboutMe || '[]'}
			contact={{sitekey, endpoint}}
			client:load 
		/>
		<Footer client:visible />
	</div>
</Layout>